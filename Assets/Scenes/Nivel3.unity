  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 470846802}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c151fa8df6046b73cb7275141ba71a30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  conversation:
  - speakerName: "T\xE9cnico Amp"
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Todav\xEDa faltan tuercas. Este es el \xFAltimo ajuste y debe quedar perfecto."
  completedConversation:
  - speakerName: "T\xE9cnico Amp"
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "\xA1Lo lograste! Las cinco tuercas cierran el circuito y el generador
      arranca."
  - speakerName: "Theo (T\xFA)"
    nameColor: {r: 1, g: 0.85, b: 0.35, a: 1}
    text: "\xA1La ciudad vuelve a brillar!"
  - speakerName: "T\xE9cnico Amp"
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: Gracias por devolvernos la luz, Theo.
  finishesLevel: 1
  dialoguePanel: {fileID: 1302723326}
  nameText: {fileID: 229997769}
  contentText: {fileID: 426786302}
  interactionPrompt: {fileID: 1597828754}
