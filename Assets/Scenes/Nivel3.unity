--- !u!114 &255187295
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 255187294}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c151fa8df6046b73cb7275141ba71a30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  conversation:
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "\xA1Bienvenido al N\xFAcleo Central, Theo! Este es el recorrido m\xE1s
      largo y peligroso de toda la red."
  - speakerName: "Theo (T\xFA)"
    nameColor: {r: 1, g: 0.85, b: 0.35, a: 1}
    text: "\xA1Hay demasiados virus all\xE1 adelante!"
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Recoge la Pistola de Pulsos El\xE9ctricos aqu\xED adelante. Dispara a
      distancia con J o clic, pero cuida tus balas: \xA1son contadas!"
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Puedes recoger cargadores extra en el camino. Re\xFAne los 5 n\xFAcleos,
      derrota a los 14 virus y vence al Megacortocircuito final."
  completedConversation:
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "\xA1Lo conseguiste, Theo! Habla con el T\xE9cnico Amp junto al reactor
      maestro para encender toda la ciudad."
  finishesLevel: 0
  dialoguePanel: {fileID: 2052638180}
  nameText: {fileID: 488905132}
  contentText: {fileID: 278546242}
  interactionPrompt: {fileID: 114238829}
