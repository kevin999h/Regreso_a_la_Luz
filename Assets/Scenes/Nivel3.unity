--- !u!114 &1152578422
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1152578421}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c151fa8df6046b73cb7275141ba71a30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  conversation:
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Este es el N\xFAcleo del generador, Theo. Aqu\xED se decide todo."
  - speakerName: "Theo (T\xFA)"
    nameColor: {r: 1, g: 0.85, b: 0.35, a: 1}
    text: Estoy listo.
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Hay m\xE1s chispas y los saltos son m\xE1s dif\xEDciles. Usa los checkpoints
      y las pilas de turbo."
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: 'Recuerda: sin circuito cerrado no hay corriente, y la potencia es P =
      V x I.'
  completedConversation:
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "\xA1Tienes las cinco tuercas! Corre al generador, al final del nivel,
      y habla con el T\xE9cnico Amp."
  finishesLevel: 0
  dialoguePanel: {fileID: 1302723326}
  nameText: {fileID: 229997769}
  contentText: {fileID: 426786302}
  interactionPrompt: {fileID: 958986370}
