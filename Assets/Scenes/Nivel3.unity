MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 593976812}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c151fa8df6046b73cb7275141ba71a30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  conversation:
  - speakerName: "T\xE9cnico Amp"
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "A\xFAn quedan n\xFAcleos por recolectar o el jefe del N\xFAcleo Central
      sigue bloqueando la red."
  completedConversation:
  - speakerName: "T\xE9cnico Amp"
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "\xA1Incre\xEDble trabajo, Theo! El N\xFAcleo Central est\xE1 al 100% de
      potencia."
  - speakerName: "Theo (T\xFA)"
    nameColor: {r: 1, g: 0.85, b: 0.35, a: 1}
    text: "\xA1Toda Ciudad Circuito volvi\xF3 a iluminarse!"
  - speakerName: "T\xE9cnico Amp"
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Dominaste la Ley de Ohm, el circuito cerrado, los fusibles y la potencia
      el\xE9ctrica. \xA1Felicitaciones, h\xE9roe de la energ\xEDa!"
  finishesLevel: 1
  dialoguePanel: {fileID: 2052638180}
  nameText: {fileID: 488905132}
  contentText: {fileID: 278546242}
  interactionPrompt: {fileID: 1188209970}
