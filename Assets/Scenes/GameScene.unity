--- !u!114 &1407066413
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1407066412}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c151fa8df6046b73cb7275141ba71a30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  conversation:
  - speakerName: "T\xE9cnico Amp"
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "A\xFAn faltan tuercas. Sin las cinco, el generador no arranca."
  - speakerName: "T\xE9cnico Amp"
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Revisa el HUD: ah\xED ves cu\xE1ntas llevas."
  completedConversation:
  - speakerName: "T\xE9cnico Amp"
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "\xA1Excelente! Con estas cinco tuercas el generador queda bien ajustado."
  - speakerName: "Theo (T\xFA)"
    nameColor: {r: 1, g: 0.85, b: 0.35, a: 1}
    text: "\xBFY ahora qu\xE9 falta?"
  - speakerName: "T\xE9cnico Amp"
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Un circuito necesita fuente, conductores y carga. Ya tenemos todo: \xA1que
      vuelva la luz!"
  finishesLevel: 1
  dialoguePanel: {fileID: 1222568261}
  nameText: {fileID: 308497635}
  contentText: {fileID: 465272755}
  interactionPrompt: {fileID: 2108804754}
