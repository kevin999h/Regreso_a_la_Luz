--- !u!114 &1706032693
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1706032692}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c151fa8df6046b73cb7275141ba71a30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  conversation:
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Bip... \xA1Theo! Mi memoria est\xE1 da\xF1ada, pero recuerdo esto: el
      generador de la ciudad se apag\xF3 y todo qued\xF3 a oscuras."
  - speakerName: "Theo (T\xFA)"
    nameColor: {r: 1, g: 0.85, b: 0.35, a: 1}
    text: "\xBFQu\xE9 necesitas que haga, BIT?"
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Cinco tuercas del generador salieron volando por el circuito. Rec\xF3gelas
      todas."
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Salta con ESPACIO y desl\xEDzate con S para pasar los t\xFAneles bajos.
      Las pilas te dan turbo por unos segundos."
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Lee los carteles y terminales con E: te ense\xF1ar\xE1n c\xF3mo funciona
      un circuito. Cuando termines, busca al T\xE9cnico Amp junto al generador."
  completedConversation:
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "\xA1Tienes las cinco tuercas! Corre al generador, al final del nivel,
      y habla con el T\xE9cnico Amp."
  finishesLevel: 0
  dialoguePanel: {fileID: 1222568261}
  nameText: {fileID: 308497635}
  contentText: {fileID: 465272755}
  interactionPrompt: {fileID: 688034031}
