--- !u!114 &1989785602
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1989785601}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c151fa8df6046b73cb7275141ba71a30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  conversation:
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "\xA1Theo! Un virus invadi\xF3 la Zona infectada y corrompi\xF3 nuestros
      chips. Tienes 3 vidas para superar el sector."
  - speakerName: "Theo (T\xFA)"
    nameColor: {r: 1, g: 0.85, b: 0.35, a: 1}
    text: "\xBFY c\xF3mo los enfrento?"
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Busca el hacha de mantenimiento m\xE1s adelante y ataca con J o clic,
      o s\xE1ltales encima."
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Recoge 5 chips y derrota a los virus. Al final te espera el Gran Cortocircuito
      (resiste 9 golpes): necesitar\xE1s el Hacha de plasma."
  completedConversation:
  - speakerName: BIT
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "\xA1Lo lograste! Ve al generador, al final del nivel, y habla con el T\xE9cnico
      Amp."
  finishesLevel: 0
  dialoguePanel: {fileID: 265030208}
  nameText: {fileID: 1301534625}
  contentText: {fileID: 476146931}
  interactionPrompt: {fileID: 187002273}
