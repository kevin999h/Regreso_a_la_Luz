  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1780800627}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c151fa8df6046b73cb7275141ba71a30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  conversation:
  - speakerName: "T\xE9cnico Amp"
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "A\xFAn no puedo reparar: faltan chips o el Gran Cortocircuito sigue activo."
  completedConversation:
  - speakerName: "T\xE9cnico Amp"
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "\xA1Excelente! Sistema limpio y chips instalados."
  - speakerName: "Theo (T\xFA)"
    nameColor: {r: 1, g: 0.85, b: 0.35, a: 1}
    text: "\xBFYa recuperamos toda la ciudad?"
  - speakerName: "T\xE9cnico Amp"
    nameColor: {r: 0.4, g: 1, b: 0.95, a: 1}
    text: "Falta el \xFAltimo sector: el N\xFAcleo Central de Alta Tensi\xF3n. \xA1Ve
      hacia all\xE1!"
  finishesLevel: 1
  dialoguePanel: {fileID: 265030208}
  nameText: {fileID: 1301534625}
  contentText: {fileID: 476146931}
  interactionPrompt: {fileID: 1289090155}
